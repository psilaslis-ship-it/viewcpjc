[Unit]
Description=ViewCPJC - players VGA e HDMI
After=viewcpjc.service
Requires=viewcpjc.service

[Service]
Type=simple
Environment=HOME=/var/lib/display
Environment=DATA_DIR=/var/lib/viewcpjc
WorkingDirectory=/opt/viewcpjc
# Xorg precisa abrir o VT; os players continuam no usuário sem privilégios "display".
ExecStart=/usr/bin/xinit /usr/sbin/runuser -u display -- /opt/viewcpjc/deploy/xinitrc -- :0 vt7 -nolisten tcp -ac
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
