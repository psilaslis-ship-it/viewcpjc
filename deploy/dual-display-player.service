[Unit]
Description=Painel de exibição dupla
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=display
WorkingDirectory=/opt/dual-display-player
Environment=NODE_ENV=production
Environment=DATA_DIR=/var/lib/dual-display-player
ExecStart=/usr/bin/node /opt/dual-display-player/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
