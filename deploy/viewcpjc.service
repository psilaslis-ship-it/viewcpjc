[Unit]
Description=ViewCPJC - painel de controle e mídia
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=display
WorkingDirectory=/opt/viewcpjc
Environment=NODE_ENV=production
Environment=DATA_DIR=/var/lib/viewcpjc
ExecStart=/usr/bin/node /opt/viewcpjc/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
